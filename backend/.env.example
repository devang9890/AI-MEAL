# Backend environment variables — copy to .env and fill in real values.
# NEVER commit .env with real secrets.

# Neon Postgres (pooled URL — hostname contains -pooler)
# sslmode=require is mandatory; drop channel_binding=require if psycopg2 errors occur.
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-CHANGE-ME-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk — Frontend publishable key (safe to expose; used by Vite/React too)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# Clerk — Secret key (server-side only; never expose in frontend bundles)
CLERK_SECRET_KEY=sk_test_CHANGE_ME

# Clerk — JWKS URL (auto-derived from publishable key domain; override only if needed)
# CLERK_JWKS_URL=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev/.well-known/jwks.json

# Groq API Configuration (server-side only; never expose in frontend)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
